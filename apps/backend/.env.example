# local: postgres://lumen:lumen@localhost:5432/lumen
# Neon (or other hosted Postgres): use the connection string from the provider,
# keeping "?sslmode=require" so the pool enables SSL automatically
DATABASE_URL=postgres://lumen:lumen@localhost:5432/lumen
PORT=4000
# comma-separated list of allowed origins (dashboard, demo-app, etc.)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
# secret used to sign access tokens — REQUIRED in production (e.g. `openssl rand -base64 48`)
JWT_SECRET=change-me-in-production
# cookies: use COOKIE_SAMESITE=none (needs HTTPS) when dashboard and API are on different domains
# COOKIE_SAMESITE=lax
# COOKIE_SECURE=false
